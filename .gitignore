# Python virtual environments
.venv/
venv/
env/

# Python cache and build artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
build/
dist/
*.egg-info/

# Logs and temporary files
*.log
*.tmp
*.temp
.DS_Store

# IDE/editor local state
.vscode/
.idea/

# Qoder：只跟踪项目级规则与 skills，其余本地状态忽略
.qoder/*
!.qoder/rules/
!.qoder/skills/

# 项目特定的忽略规则已分散到各项目目录的 .gitignore：
#   1xx：100-openVLA、101-pi-serial-models、102-cosmos、103-lingbot、104-unitreerobotics
#   2xx：200-video
#   3xx：300-robots、301-microduck、302-kingkongrobotics
#   5xx：500-umr（501 为独立克隆，用其自身 .gitignore）
#   底座：models、assets

# Large local model/checkpoint artifacts
*.ckpt
*.pt
*.pth
*.safetensors
*.bin
*.npy
*.ply
*.mp4

# Preventive: training/download byproducts not present yet
nohup.out
*.whl
wandb/
MUJOCO_LOG.TXT

# MuJoCo 运行时临时文件
.scene_drag_tmp.xml